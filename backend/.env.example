# Modelo de configuração do backend.
# Copie para ".env" e ajuste os valores. O arquivo ".env" NÃO vai para o git.

# --- Banco de dados -------------------------------------------------------------
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pet_encanto

# --- Autenticação --------------------------------------------------------------
# Segredo usado para assinar os tokens JWT. GERE UM NOVO com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-forte
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Primeiro acesso (dono do petshop) ---------------------------------------
# Usados pelo script scripts/seed_admin.py para criar a conta do dono.
FIRST_ADMIN_EMAIL=dono@petencanto.local
FIRST_ADMIN_PASSWORD=troque-por-uma-senha-forte
FIRST_ADMIN_NAME=Dono

# --- Ambiente ----------------------------------------------------------------
# "development" ou "production". Em production o cookie de sessão vai com flag
# Secure (exige HTTPS) e a documentação /docs é desabilitada.
ENV=development

# Origem(ns) do frontend liberada(s) no CORS — separe por vírgula se for mais de uma.
FRONTEND_ORIGIN=http://localhost:5173

# SameSite do cookie de sessão: "lax" (padrão) ou "none" (domínios diferentes).
COOKIE_SAMESITE=lax

# Caminho do build do frontend a servir junto com a API (opcional).
# FRONTEND_DIST=../dist

# --- Upload de fotos ----------------------------------------------------------
# Pasta (relativa à pasta backend/) onde fotos de pets/produtos são salvas.
UPLOADS_DIR=uploads
